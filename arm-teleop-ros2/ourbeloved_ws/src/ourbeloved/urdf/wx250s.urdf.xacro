<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xml>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wx250s">

  <xacro:property name="base_length" value="0.08" />
  <xacro:property name="base_radius" value="0.05" />
  <xacro:property name="L1" value="0.03" />
  <xacro:property name="L1radius" value="0.02" />
  <xacro:property name="L2_horizontal" value="0.03" />
  <xacro:property name="L2_horizontal_radius" value="0.02" />
  <xacro:property name="L2_vertical" value="0.25" />
  <xacro:property name="L2_vertical_radius" value="0.01" />
  <xacro:property name="L2_to_joint" value="0.05" />
  <xacro:property name="L2_to_joint_radius" value="0.01" />
  <xacro:property name="L3" value="0.03" />
  <xacro:property name="L3radius" value="0.02" />
  <xacro:property name="L3_rod" value="0.17155" />
  <xacro:property name="L3_rod_radius" value="0.01" />
  <xacro:property name="L4" value="0.07845" />
  <xacro:property name="L4radius" value="0.02" />
  <xacro:property name="L5" value="0.03" />
  <xacro:property name="L5radius" value="0.02" />
  <xacro:property name="L5_to_joint" value="0.065" />
  <xacro:property name="L5_to_joint_radius" value="0.01" />
  <xacro:property name="L6" value="0.03" />
  <xacro:property name="L6radius" value="0.02" />
  <xacro:property name="L6_to_ee" value="0.066" />
  <xacro:property name="L6_to_ee_radius" value="0.01" />
  <xacro:property name="ee_slider_length" value="0.064" />
  <xacro:property name="ee_slider_width" value="0.01" />
  <xacro:property name="ee_finger_length" value="0.04315" />
  <xacro:property name="ee_finger_width" value="0.01" />
  <xacro:property name="ee_height" value="0.032" />
  <xacro:property name="J1MIN" value="${-pi}" />
  <xacro:property name="J1MAX" value="${pi}" />
  <xacro:property name="J2MIN" value="-1.88" />
  <xacro:property name="J2MAX" value="1.95" />
  <xacro:property name="J3MIN" value="-2.14" />
  <xacro:property name="J3MAX" value="1.60" />
  <xacro:property name="J4MIN" value="${-pi}" />
  <xacro:property name="J4MAX" value="${pi}" />
  <xacro:property name="J5MIN" value="-1.74" />
  <xacro:property name="J5MAX" value="2.14" />
  <xacro:property name="J6MIN" value="${-pi}" />
  <xacro:property name="J6MAX" value="${pi}" />  

  <material name="blue">
    <color rgba="0.2 0.4 0.65 1" />
  </material>

  <material name="yellow">
    <color rgba="1 0.85 0 1" />
  </material>

  <link name="world" />

  <link name="base">
    <visual name="base">
      <origin xyz="0 0 ${base_length/2}" />
      <geometry>
        <cylinder radius="${base_radius}" length="${base_length}" />
      </geometry>
      <material name="blue" />
    </visual>
  </link>

  <link name="link1">
    <visual name="link1">
      <origin xyz="0 0 ${L1/2}" rpy="0 0 0" />
      <geometry>
        <cylinder radius="${L1radius}" length="${L1}" />
      </geometry>
      <material name="blue" />
    </visual>
  </link>

  <link name="link2">
    <visual name="link2">
      <origin xyz="0 0 0" rpy="0 ${pi/2} 0" />
      <geometry>
        <cylinder radius="${L2_horizontal_radius}" length="${L2_horizontal}" />
      </geometry>
      <material name="blue" />
    </visual>
    <visual>
      <origin xyz="0 0 ${L2_vertical/2}" rpy="0 0 0" />
      <geometry>
        <cylinder radius="${L2_vertical_radius}" length="${L2_vertical}" />
      </geometry>
      <material name="blue" />
    </visual>
    <visual>
      <origin xyz="0 ${L2_to_joint/2} ${L2_vertical}" rpy="${-pi/2} 0 0" />
      <geometry>
        <cylinder radius="${L2_to_joint_radius}" length="${L2_to_joint}" />
      </geometry>
      <material name="blue" />
    </visual>
  </link>

  <link name="link3">
    <visual name="link3">
      <origin xyz="0 0 0" rpy="0 ${pi/2} 0" />
      <geometry>
        <cylinder radius="${L3radius}" length="${L3}" />
      </geometry>
      <material name="blue" />
    </visual>
    <visual>
      <origin xyz="0 ${L3_rod/2} 0" rpy="${pi/2} 0 0" />
      <geometry>
        <cylinder radius="${L3_rod_radius}" length="${L3_rod}" />
      </geometry>
      <material name="blue" />
    </visual>
  </link>

  <link name="link4">
    <visual name="link4">
      <origin xyz="0 ${L4/2} 0" rpy="${pi/2} 0 0" />
      <geometry>
        <cylinder radius="${L4radius}" length="${L4}" />
      </geometry>
      <material name="blue" />
    </visual>
  </link>

  <link name="link5">
    <visual name="link5">
      <origin xyz="0 0 0" rpy="0 ${pi/2} 0" />
      <geometry>
        <cylinder radius="${L5radius}" length="${L5}" />
      </geometry>
      <material name="blue" />
    </visual>
    <visual>
      <origin xyz="0 ${L5_to_joint/2} 0" rpy="${pi/2} 0 0" />
      <geometry>
        <cylinder radius="${L5_to_joint_radius}" length="${L5_to_joint}" />
      </geometry>
      <material name="blue" />
    </visual>
  </link>

  <link name="link6">
    <visual name="link6">
      <origin xyz="0 ${L6/2} 0" rpy="${pi/2} 0 0" />
      <geometry>
        <cylinder radius="${L6radius}" length="${L6}" />
      </geometry>
      <material name="blue" />
    </visual>
    <visual>
      <origin xyz="0 ${L6_to_ee/2} 0" rpy="${pi/2} 0 0" />
      <geometry>
        <cylinder radius="${L6_to_ee_radius}" length="${L6_to_ee}" />
      </geometry>
      <material name="blue" />
    </visual>
  </link>

  <link name="ee_slider">
    <visual name="ee_slider">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${ee_slider_length} ${ee_slider_width} ${ee_height}" />
      </geometry>
      <material name="yellow" />
    </visual>
  </link>

  <link name="ee_finger_1">
    <visual name="ee_finger_1">
      <origin xyz="0 ${ee_finger_length/2} 0" rpy="0 0 ${pi/2}" />
      <geometry>
        <box size="${ee_finger_length} ${ee_finger_width} ${ee_height}" />
      </geometry>
      <material name="yellow" />
    </visual>
  </link>

  <link name="ee_finger_2">
    <visual name="ee_finger_2">
      <origin xyz="0 ${ee_finger_length/2} 0" rpy="0 0 ${pi/2}" />
      <geometry>
        <box size="${ee_finger_length} ${ee_finger_width} ${ee_height}" />
      </geometry>
      <material name="yellow" />
    </visual>
  </link>

  <joint name="base_in_world" type="fixed">
    <parent link="world" />
    <child link="base" />
    <origin xyz="0 ${-L2_to_joint-L3_rod-L4-L5_to_joint-L6_to_ee} 0" rpy="0 0 ${pi/2}" />
  </joint>

  <joint name="waist" type="revolute">
    <parent link="base" />
    <child link="link1" />
    <origin xyz="0 0 ${base_length}" rpy="0 0 ${-pi/2}" />
    <axis xyz="0 0 1" />
    <limit lower="${J1MIN}" upper="${J1MAX}" effort="1" velocity="1" />
  </joint>

  <joint name="shoulder" type="revolute">
    <parent link="link1" />
    <child link="link2" />
    <origin xyz="0 0 ${L1}" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="${J2MIN}" upper="${J2MAX}" effort="1" velocity="1" />
  </joint>

  <joint name="elbow" type="revolute">
    <parent link="link2" />
    <child link="link3" />
    <origin xyz="0 ${L2_to_joint} ${L2_vertical}" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="${J3MIN}" upper="${J3MAX}" effort="1" velocity="1" />
  </joint>

  <joint name="forearm_roll" type="revolute">
    <parent link="link3" />
    <child link="link4" />
    <origin xyz="0 ${L3_rod} 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="${J4MIN}" upper="${J4MAX}" effort="1" velocity="1" />
  </joint>

  <joint name="wrist_angle" type="revolute">
    <parent link="link4" />
    <child link="link5" />
    <origin xyz="0 ${L4} 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="${J5MIN}" upper="${J5MAX}" effort="1" velocity="1" />
  </joint>

  <joint name="wrist_rotate" type="revolute">
    <parent link="link5" />
    <child link="link6" />
    <origin xyz="0 ${L5_to_joint} 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="${J6MIN}" upper="${J6MAX}" effort="1" velocity="1" />
  </joint>

  <joint name="ee_in_link6" type="fixed">
    <parent link="link6" />
    <child link="ee_slider" />
    <origin xyz="0 ${L6_to_ee} 0" rpy="0 0 0" />
  </joint>

  <joint name="ee_finger_1_joint" type="prismatic">
    <parent link="ee_slider" />
    <child link="ee_finger_1" />
    <origin xyz="${ee_slider_length/2} 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="${-ee_slider_length/2}" upper="0" effort="1" velocity="1" />
  </joint>

  <joint name="ee_finger_2_joint" type="prismatic">
    <parent link="ee_slider" />
    <child link="ee_finger_2" />
    <origin xyz="${-ee_slider_length/2} 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="0" upper="${ee_slider_length/2}" effort="1" velocity="1" />
  </joint>

</robot>
